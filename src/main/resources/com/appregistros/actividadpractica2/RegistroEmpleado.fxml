<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="620.0" prefWidth="780.0" spacing="15.0" style="-fx-background-color: #ffead4;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.appregistros.actividadpractica2.controller.EmpleadoController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Registro de Empleados">
      <font>
         <Font name="System Bold" size="24.0" />
      </font></Label>

    <!-- Formulario -->
    <GridPane hgap="15.0" vgap="12.0">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="70.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
            <ColumnConstraints halignment="RIGHT" minWidth="70.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
        </columnConstraints>

        <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtCodigo" promptText="001" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombre" promptText="Nombre completo" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtCorreo" promptText="correo@empresa.com.ni" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Cargo:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtCargo" promptText="Cargo" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label text="Salario:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtSalario" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <!-- Botones -->
    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="btnGuardar" onAction="#Guardar" prefWidth="100.0" style="-fx-background-color: #00ffab;" text="Guardar" />
        <Button fx:id="btnActualizar" onAction="#Actualizar" prefWidth="100.0" text="Actualizar" />
        <Button fx:id="btnEliminar" onAction="#Eliminar" prefWidth="100.0" text="Eliminar" />
        <Button fx:id="btnLimpiar" onAction="#Limpiar" prefWidth="100.0" text="Limpiar" />
        <Button fx:id="btnBuscar" onAction="#BuscarEmpleado" prefWidth="100.0" text="Buscar" />
        <Button fx:id="btnQuitarFiltros" onAction="#QuitarFiltros" prefWidth="120.0" text="Quitar filtros" />
    </HBox>

    <!-- Búsqueda: tres filtros independientes -->
    <TitledPane collapsible="false" text="Búsqueda">
        <content>
            <HBox spacing="15.0" style="-fx-background-color: #ccf5e7;">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>

                <!-- Filtro 1 -->
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <ComboBox fx:id="cmbFiltro1" maxWidth="Infinity" promptText="Columna">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Código" />
                                <String fx:value="Nombre" />
                                <String fx:value="Correo" />
                                <String fx:value="Cargo" />
                                <String fx:value="Salario" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                    <TextField fx:id="txtFiltro1" promptText="Valor a buscar" />
                </VBox>

                <!-- Filtro 2 -->
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <ComboBox fx:id="cmbFiltro2" maxWidth="Infinity" promptText="Columna">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Código" />
                                <String fx:value="Nombre" />
                                <String fx:value="Correo" />
                                <String fx:value="Cargo" />
                                <String fx:value="Salario" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                    <TextField fx:id="txtFiltro2" promptText="Valor a buscar" />
                </VBox>

                <!-- Filtro 3 -->
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <ComboBox fx:id="cmbFiltro3" maxWidth="Infinity" promptText="Columna">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Código" />
                                <String fx:value="Nombre" />
                                <String fx:value="Correo" />
                                <String fx:value="Cargo" />
                                <String fx:value="Salario" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                    <TextField fx:id="txtFiltro3" promptText="Valor a buscar" />
                </VBox>
            </HBox>
        </content>
    </TitledPane>

    <!-- Tabla -->
    <TableView fx:id="tblEmpleados" style="-fx-background-color: #ccf5e7;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
            <TableColumn fx:id="colCorreo" prefWidth="200.0" text="Correo" />
            <TableColumn fx:id="colCargo" prefWidth="160.0" text="Cargo" />
            <TableColumn fx:id="colSalario" prefWidth="100.0" text="Salario" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
